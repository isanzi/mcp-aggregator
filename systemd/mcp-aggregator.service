[Unit]
Description=MCP aggregator (one shared MCP tool surface for every client)
After=network.target

[Service]
Type=simple
Environment=AGG_HTTP_PORT=8877
ExecStart=/usr/bin/node /opt/mcp-aggregator/index.mjs
WorkingDirectory=/opt/mcp-aggregator
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
